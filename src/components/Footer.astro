---
import {
	footerConfig,
	licenseConfig,
	profileConfig,
} from "@/config";
import { resolveHref, url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
const copyrightText =
	currentYear > footerConfig.startYear
		? `${footerConfig.startYear} - ${currentYear}`
		: `${currentYear}`;
const poweredBy = footerConfig.poweredBy ?? [];
---

<div class="card-base w-fit mx-auto rounded-xl mt-4 mb-4">
	<div class="transition text-50 text-sm text-center p-6">
		© <span id="copyright-year">{copyrightText}</span>
		<a class="transition link text-[var(--primary)] font-medium" href={url("/")}>
			{profileConfig.name}
		</a>
		<br>

		<a
			class="transition link text-[var(--primary)] font-medium"
			target="_blank"
			rel="noopener noreferrer"
			href={licenseConfig.url}
		>
			{licenseConfig.name}
		</a>
		<br>

		{footerConfig.links.map((link, index) => (
			<>
				{index > 0 && " / "}
				<a
					class="transition link text-[var(--primary)] font-medium"
					href={resolveHref(link.url)}
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noopener noreferrer" : undefined}
				>
					{link.label}
				</a>
			</>
		))}
		<br>

		由
		{poweredBy.map((link, index) => (
			<>
				{" "}
				<a
					class="transition link text-[var(--primary)] font-medium"
					href={resolveHref(link.url)}
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noopener noreferrer" : undefined}
				>
					{link.label}
				</a>
				{index < poweredBy.length - 1 ? " &" : " 强力驱动"}
			</>
		))}
	</div>
</div>
